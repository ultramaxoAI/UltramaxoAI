# ============================================
# UltramaxoAI Environment Variables
# ============================================

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Node environment (development, production, test)
NODE_ENV=production

# Your production domain (required for emails and reset links)
# Example: https://ultramaxo.tech or https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://ultramaxo.tech

# ============================================
# Database (PostgreSQL)
# ============================================
# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
# Or use Neon, Supabase, Railway, etc.
POSTGRES_URL=****

# ============================================
# AI Configuration
# ============================================
# Groq API Keys for AI chat (at least one required)
# Get your keys from: https://console.groq.com/keys
# Support multiple keys for load balancing and fallback
GROQ_API_KEY=****
GROQ_API_KEY_1=****
GROQ_API_KEY_2=****

# ============================================
# File Storage (Vercel Blob)
# ============================================
# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
# Required for profile images and file uploads
BLOB_READ_WRITE_TOKEN=****

# ============================================
# Email Service (SMTP via Nodemailer)
# ============================================
# Configure SMTP server for email sending
# Gmail: smtp.gmail.com:587 (requires App Password)
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Ultramaxo AI <noreply@ultramaxo.tech>"

# ============================================
# Redis (Optional but Recommended)
# ============================================
# Instructions to create a Redis store here: https://vercel.com/docs/redis
# Used for rate limiting and session management
# Without Redis, rate limiting resets on server restart
REDIS_URL=****

# ============================================
# OAuth Providers (Optional)
# ============================================
# Google OAuth
AUTH_GOOGLE_ID=****
AUTH_GOOGLE_SECRET=****

# GitHub OAuth
AUTH_GITHUB_ID=****
AUTH_GITHUB_SECRET=****

# ============================================
# Admin Configuration
# ============================================
# Admin email for system notifications and admin role assignment
ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# Monitoring & Analytics (Optional)
# ============================================
# Sentry DSN for error tracking
# Get from: https://sentry.io
SENTRY_DSN=****

# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed
