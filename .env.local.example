# ============================================
# Local Development Environment Variables
# Copy this file to .env.local for local development
# ============================================

# Generate a random secret: https://generate-secret.vercel.app/32
AUTH_SECRET=your-local-secret-key-here

# Node environment
NODE_ENV=development

# Your local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Database (PostgreSQL) - Local or Cloud
# ============================================
# Option 1: Use Vercel Postgres locally (recommended)
# POSTGRES_URL=your-vercel-postgres-url

# Option 2: Local PostgreSQL
# POSTGRES_URL=postgresql://user:password@localhost:5432/ultramaxo

# ============================================
# AI Configuration
# ============================================
# Groq API Keys (optional for local dev if using local AI)
GROQ_API_KEY=your-groq-api-key

# Local AI Server (Llama 3)
# Leave commented to use automatic detection:
#   - Local: http://localhost:8000/v1
#   - Or uncomment and set custom URL:
# LOCAL_AI_URL=http://localhost:8000/v1

# ============================================
# File Storage (Vercel Blob)
# ============================================
# Use your Vercel Blob token (same as production)
BLOB_READ_WRITE_TOKEN=your-blob-token

# ============================================
# Email Service (Optional for local dev)
# ============================================
# Use Mailtrap or similar for local email testing
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-pass
# EMAIL_FROM="Ultramaxo AI Local <dev@localhost>"

# Or use Gmail for testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="Ultramaxo AI <your-email@gmail.com>"

# ============================================
# Redis (Optional)
# ============================================
# REDIS_URL=your-redis-url

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@localhost
